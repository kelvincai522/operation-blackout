# Capture output from tools/shoot.py and the critique loop.
# This grows to hundreds of MB of scratch PNGs during an agent round.
# Reference images that are worth keeping live in docs/ instead.
shots/

# tools/shoot.py --outdir writes a capture set plus a report.json anywhere it is
# pointed. Agents use throwaway directories for A/B comparisons; none of it
# belongs in the repo.
**/report.json
*_lowq*/
*_shots/
_scratch*/

# Scratch pages written and deleted by tools/check.py and tools/playtest.py.
# They are removed on a clean exit; these rules cover crashes and Ctrl-C.
#
# playtest.py's page used to be the single fixed name ._playtest.html. It is now
# namespaced per level/tag/pid so concurrent agents stop deleting it out from
# under each other, so the glob has to cover the suffixed form too - one of these
# was committed by accident before this rule existed.
._check_*.html
._playtest*.html
._audio.html

# Python
__pycache__/
*.py[cod]

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# docs/embed/ holds the source media for tools/build_writeup.py and IS tracked,
# so the self-contained write-up can be rebuilt from a clean clone.
